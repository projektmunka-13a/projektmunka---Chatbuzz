<Window x:Class="ChatBuzz_admin_wpf.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ChatBuzz_admin_wpf"
        mc:Ignorable="d"
        Title="LoginWindow" Height="400" Width="300">
    <Grid>
        <StackPanel Orientation="Vertical" Margin="10">
            <Label Content="Username:" Margin="5"/>
            <TextBox x:Name="usernameBox" Margin="5"/>
            <Label Content="Password:" Margin="5"/>
            <PasswordBox x:Name="passwordBox" Margin="5"/>
            <Button Content="Login" Margin="5" Click="LoginButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
