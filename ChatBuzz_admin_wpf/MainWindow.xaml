<Window x:Class="ChatBuzz_admin_wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ChatBuzz_admin_wpf"
        mc:Ignorable="d"
        Title="Admin Panel - ChatBuzz" Height="900" Width="1200">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*"/>
            <ColumnDefinition Width="1*"/>
            <ColumnDefinition Width="1*"/>
        </Grid.ColumnDefinitions>
 
        <StackPanel Grid.Column="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="1*"/>
                    <RowDefinition Height="5*"/>
                    <RowDefinition Height="1*"/>
                </Grid.RowDefinitions>
                <Label Content="Users" Margin="0,20,0,0" HorizontalAlignment="Center" Grid.Row="0"/>
                <DataGrid x:Name="usersdatagrid"  MaxHeight="600" MinHeight="600" Margin="15" Grid.Row="1" IsReadOnly="True" SelectionChanged="usersdatagrid_SelectionChanged" SelectionMode="Single"/>
                <WrapPanel HorizontalAlignment="Center" Grid.Row="2">
                    <Button x:Name="userdatabutton" Margin="5" Width="150" FontSize="20"  Content="User data" Click="seeUserdatabuttonclick" />
                    <Button x:Name="banuserbutton" Margin="5" Width="150" FontSize="20"  Content="Ban user" Click="banuserbuttonclick"/>
                    <Button x:Name="unbanuserbutton" Margin="5" Width="150" FontSize="20"  Content="Unban user" Click="unbanuserbuttonclick"/>
                    <Button x:Name="deleteuserbutton" Margin="5" Width="150" FontSize="20"  Content="Delete user" Background="Red" FontWeight="Bold" Click="deleteuserbuttonclick"/>
                    <Button x:Name="showdatabutton" Margin="10,20,10,10" Width="300" FontSize="20"  Content="Show users activity" Click="showusersactivitybuttonclick" />
                </WrapPanel>
            </Grid>
        </StackPanel>
        <StackPanel Grid.Column="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="1*"/>
                    <RowDefinition Height="1*"/>
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0">
                    <Label Content="Friends" Margin="0,20,0,0" HorizontalAlignment="Center"/>
                    <DataGrid x:Name="friendsdatagrid" MaxHeight="250" MinHeight="250" IsReadOnly="True"/>
                    <WrapPanel HorizontalAlignment="Center">
                        <Button Width="150" Margin="10" FontSize="20"  Content="See friend"/>
                        <Button Width="150" Margin="10" FontSize="12" Background="Red" FontWeight="Bold" Content="Delete friend from list"/>
                    </WrapPanel>
                </StackPanel>
                <StackPanel Grid.Row="1">
                    <Label Content="Posts" Margin="0,20,0,0" HorizontalAlignment="Center"/>
                    <!--<DataGrid x:Name="postsdatagrid" MaxHeight="250" MinHeight="250" Margin="15" IsReadOnly="True"/>-->
                    <DataGrid x:Name="postsdatagrid" MaxHeight="250" MinHeight="250" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Username" Binding="{Binding username}" />
                            <DataGridTextColumn Header="Content" Binding="{Binding content}" Width="*" />
                            <DataGridTextColumn Header="Created at"
                            Binding="{Binding created_at, StringFormat={}{0:yyyy.MM.dd HH:mm}}" />
                        </DataGrid.Columns>
                    </DataGrid> 
                    <WrapPanel HorizontalAlignment="Center">
                        <Button Width="150" Margin="10" FontSize="20"  Content="See post"/>
                        <Button Width="150" Margin="10" FontSize="20" Background="Red" FontWeight="Bold" Content="Delete post"/>
                    </WrapPanel>
                </StackPanel>
            </Grid>
        </StackPanel>
        <StackPanel Grid.Column="2">
            <Label Content="Comments" Margin="0,20,0,0" HorizontalAlignment="Center"/>
            <DataGrid x:Name="commentsdatagrid" AutoGenerateColumns="False" MaxHeight="600" MinHeight="600" Margin="15" IsReadOnly="True" SelectionMode="Single">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Post_id" Binding="{Binding post_id}"/>
                    <DataGridTextColumn Header="Username" Binding="{Binding username}"/>
                    <DataGridTextColumn Header="Content" Binding="{Binding content}"/>
                    <DataGridTextColumn Header="Created_at" Binding="{Binding created_at}"/>
                </DataGrid.Columns>
            </DataGrid>
            <WrapPanel HorizontalAlignment="Center">
                <Button Width="150" Margin="10" FontSize="20"  Content="See comment"/>
                <Button Width="150" Margin="10" FontSize="20" Background="Red" FontWeight="Bold" Content="Delete comment"/>
            </WrapPanel>
        </StackPanel>
    </Grid>
</Window>
